{
  "dataRoles": [
    {
      "displayName": "Valor Principal",
      "name": "value",
      "kind": "Measure"
    },
    {
      "displayName": "Variación / Delta %",
      "name": "delta",
      "kind": "Measure"
    },
    {
      "displayName": "Tooltips Adicionales",
      "name": "tooltipFields",
      "kind": "Measure"
    }
  ],
  "objects": {
    "cardStyle": {
      "displayName": "Estilo de Tarjeta",
      "properties": {
        "themeVariant": {
          "displayName": "Variante de Color",
          "type": {
            "enumeration": [
              { "displayName": "Primario (Azul)", "value": "blue" },
              { "displayName": "Primario (Token)", "value": "primary" },
              { "displayName": "Oscuro / Grafito", "value": "dark" },
              { "displayName": "Positivo (Verde)", "value": "green" },
              { "displayName": "Terciario (Turquesa)", "value": "teal" },
              { "displayName": "Secundario (Púrpura)", "value": "purple" },
              { "displayName": "Blanco Minimal", "value": "light" }
            ]
          }
        },
        "surfaceMode": {
          "displayName": "Acabado de superficie",
          "type": {
            "enumeration": [
              { "displayName": "Automático (desde tema)", "value": "auto" },
              { "displayName": "Degradado SnowUI", "value": "gradient" },
              { "displayName": "Plano Corporativo", "value": "solid" },
              { "displayName": "Blanco con Borde", "value": "light-bordered" }
            ]
          }
        },
        "titleOverride": {
          "displayName": "Título personalizado",
          "type": { "text": true }
        },
        "subtitleText": {
          "displayName": "Subtítulo delta",
          "type": { "text": true }
        },
        "cornerRadius": {
          "displayName": "Radio de borde (px)",
          "type": { "numeric": true }
        },
        "animationMs": {
          "displayName": "Duración transición (ms)",
          "type": { "numeric": true }
        }
      }
    },
    "numberFormat": {
      "displayName": "Formato Numérico",
      "properties": {
        "currencyMode": {
          "displayName": "Modo de moneda",
          "type": {
            "enumeration": [
              { "displayName": "Automático (desde medida DAX)", "value": "auto" },
              { "displayName": "Moneda de marca (brand-config)", "value": "brand" },
              { "displayName": "Prefijo personalizado", "value": "custom" }
            ]
          }
        },
        "valuePrefix": {
          "displayName": "Prefijo personalizado",
          "type": { "text": true }
        },
        "valueSuffix": {
          "displayName": "Sufijo",
          "type": { "text": true }
        },
        "displayUnits": {
          "displayName": "Unidades",
          "type": {
            "enumeration": [
              { "displayName": "Automático", "value": "auto" },
              { "displayName": "Millones (M)", "value": "millions" },
              { "displayName": "Miles (K)", "value": "thousands" },
              { "displayName": "Ninguno", "value": "none" },
              { "displayName": "Porcentaje (%)", "value": "percent" }
            ]
          }
        },
        "decimals": {
          "displayName": "Decimales",
          "type": { "numeric": true }
        },
        "deltaIsRatio": {
          "displayName": "Delta como ratio (0.11 = 11%)",
          "type": { "bool": true }
        },
        "deltaSuffix": {
          "displayName": "Sufijo de delta",
          "type": { "text": true }
        }
      }
    }
  },
  "dataViewMappings": [
    {
      "conditions": [
        {
          "value": { "max": 1 },
          "delta": { "max": 1 },
          "tooltipFields": { "max": 5 }
        }
      ],
      "table": {
        "rows": {
          "select": [
            { "bind": { "to": "value" } },
            { "bind": { "to": "delta" } },
            { "for": { "in": "tooltipFields" } }
          ],
          "dataReductionAlgorithm": {
            "top": { "count": 5 }
          }
        }
      }
    }
  ],
  "privileges": []
}
