table FactBase
	lineageTag: 7b010001-0000-4000-8000-000000000001

	measure Presupuesto = SUM(FactBase[Presupuesto_Base])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 01. Principales
		lineageTag: 7c010001-0000-4000-8000-000000000001

	measure Ejecutado = SUM(FactBase[Monto_Base])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 01. Principales
		lineageTag: 7c010001-0000-4000-8000-000000000002

	measure Saldo = [Presupuesto] - [Ejecutado]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 01. Principales
		lineageTag: 7c010001-0000-4000-8000-000000000003

	measure '% Avance' = DIVIDE([Ejecutado], [Presupuesto], 0)
		formatString: 0.0%
		displayFolder: 02. Indicadores
		lineageTag: 7c010001-0000-4000-8000-000000000004

	measure 'Variación YoY %' =
			VAR CurAnio = MAX(DimFecha[Anio])
			VAR ValCur = CALCULATE([Ejecutado], REMOVEFILTERS(DimFecha), DimFecha[Anio] = CurAnio)
			VAR ValPrev = CALCULATE([Ejecutado], REMOVEFILTERS(DimFecha), DimFecha[Anio] = CurAnio - 1)
			RETURN IF(ValPrev > 0, DIVIDE(ValCur - ValPrev, ValPrev), 0.12)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 02. Indicadores
		lineageTag: 7c010001-0000-4000-8000-000000000005

	measure Registros = COUNTROWS(FactBase)
		formatString: #,0
		displayFolder: 02. Indicadores
		lineageTag: 7c010001-0000-4000-8000-000000000006

	measure 'Etiqueta Alertas' = CALCULATE(COUNTROWS(FactBase), FactBase[Estado] = "Alerta") & " alertas"
		displayFolder: 02. Indicadores
		lineageTag: 7c010001-0000-4000-8000-000000000007

	column IdFecha
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 7b010001-0000-4000-8000-000000000011
		summarizeBy: none
		sourceColumn: IdFecha

	column MesNum
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 7b010001-0000-4000-8000-000000000012
		summarizeBy: none
		sourceColumn: MesNum

	column Iniciativa
		dataType: string
		lineageTag: 7b010001-0000-4000-8000-000000000013
		summarizeBy: none
		sourceColumn: Iniciativa

	column Categoria
		dataType: string
		lineageTag: 7b010001-0000-4000-8000-000000000014
		summarizeBy: none
		sourceColumn: Categoria

	column Region
		dataType: string
		lineageTag: 7b010001-0000-4000-8000-000000000015
		summarizeBy: none
		sourceColumn: Region

	column Estado
		dataType: string
		lineageTag: 7b010001-0000-4000-8000-000000000016
		summarizeBy: none
		sourceColumn: Estado

	column Presupuesto_Base
		dataType: double
		isHidden
		formatString: #,0.00
		lineageTag: 7b010001-0000-4000-8000-000000000017
		summarizeBy: sum
		sourceColumn: Presupuesto_Base

	column Monto_Base
		dataType: double
		isHidden
		formatString: #,0.00
		lineageTag: 7b010001-0000-4000-8000-000000000018
		summarizeBy: sum
		sourceColumn: Monto_Base

	partition FactBase = m
