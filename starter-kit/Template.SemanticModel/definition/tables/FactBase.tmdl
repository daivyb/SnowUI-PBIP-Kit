				        type table [IdFecha = Int64.Type, MesNum = Int64.Type, Iniciativa = text, Categoria = text, Region = text, Estado = text, Presupuesto_Base = number, Monto_Base = number],
				        {
				            {20250115, 1, "Modernización Core", "Operaciones", "Lima", "Activo", 420000, 360000},
				            {20250215, 2, "Expansión Canal Digital", "Comercial", "Arequipa", "Activo", 380000, 315000},
				            {20250315, 3, "Plataforma Datos", "Tecnología", "Lima", "En Curso", 510000, 390000},
				            {20250415, 4, "Eficiencia Logística", "Operaciones", "Cusco", "Alerta", 290000, 145000},
				            {20260115, 1, "Modernización Core", "Operaciones", "Lima", "Activo", 480000, 410000},
