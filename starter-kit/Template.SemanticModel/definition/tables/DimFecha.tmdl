table DimFecha
	lineageTag: 7a010001-0000-4000-8000-000000000001

	column IdFecha
		dataType: int64
		isHidden
		isKey
		formatString: 0
		lineageTag: 7a010001-0000-4000-8000-000000000011
		summarizeBy: none
		sourceColumn: IdFecha

	column Fecha
		dataType: dateTime
		formatString: Short Date
		lineageTag: 7a010001-0000-4000-8000-000000000012
		summarizeBy: none
		sourceColumn: Fecha

		annotation UnderlyingDateTimeDataType = Date

	column Anio
		dataType: int64
		formatString: 0
		lineageTag: 7a010001-0000-4000-8000-000000000013
		summarizeBy: none
		sourceColumn: Anio

	partition DimFecha = m
		mode: import
		source =
				let
				    StartDate = #date(2024, 1, 1),
				    Dates = List.Dates(StartDate, 1096, #duration(1, 0, 0, 0)),
				    Tbl = Table.FromList(Dates, Splitter.SplitByNothing(), {"Fecha"}),
				    Typed = Table.TransformColumnTypes(Tbl, {{"Fecha", type date}}),
				    WithId = Table.AddColumn(Typed, "IdFecha", each Date.Year([Fecha]) * 10000 + Date.Month([Fecha]) * 100 + Date.Day([Fecha]), Int64.Type),
				    WithAnio = Table.AddColumn(WithId, "Anio", each Date.Year([Fecha]), Int64.Type)
				in
				    WithAnio

	annotation PBI_ResultType = Table
